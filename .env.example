#
# Shared stack identity
INFRA_STACK_NAME=infra
INFRA_NETWORK_NAME=infra

# Host & Networking overrides (optional)
PUBLIC_HOST=127.0.0.1
PROBE_HOST=127.0.0.1
DOCKER_BUILD_NETWORK=host
SWARM_ADVERTISE_ADDR=

# Required app-facing settings
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_postgres_password
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=change_me_pgadmin_password
REDIS_PASSWORD=change_me_redis_password
GRAFANA_PASSWORD=change_me_grafana_password

# PgBouncer
PGBOUNCER_PORT=6543
PGBOUNCER_BIND_ADDR=0.0.0.0
PGBOUNCER_AUTH_USER=pgbouncer_auth
PGBOUNCER_AUTH_PASSWORD=change_me_pgbouncer_auth_password
# Set to true to enable self-signed TLS (cert auto-generated by setup.sh)
PGBOUNCER_TLS_ENABLED=false
# NOTE: PostgreSQL has no host port on purpose — it is overlay-only
# (postgres:5432). All host/external traffic goes through PgBouncer above.
PGADMIN_PORT=5050
REDIS_PORT=6379

# Backups: local + optional Cloudflare R2 upload
BACKUP_INTERVAL_SECONDS=43200
BACKUP_RETENTION=2
R2_BACKUP_ENABLED=false
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PREFIX=infra/
R2_MAX_BACKUPS_PER_DB=2

# Postgres image: default is custom build (PostGIS + pgvector + pg_cron)
# Override with a registry image (e.g. postgis/postgis:17-3.5-alpine) to skip the build
POSTGRES_IMAGE=infra/postgres:latest

# Optional monitoring and alerts
GRAFANA_PORT=3030
GRAFANA_USER=admin
PROMETHEUS_PORT=9090
PROMETHEUS_RETENTION=15d
LOKI_PORT=3100
ALERTMANAGER_PORT=9093
ALERT_EMAIL_TO=
ALERT_FROM=alerts@example.com
SMTP_SMARTHOST=smtp.gmail.com:587
SMTP_USER=
SMTP_PASSWORD=

# R2 endpoint override (empty = https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com)
R2_ENDPOINT=

# PgBouncer pool tuning (used when rendering pgbouncer.ini)
PGBOUNCER_DEFAULT_POOL_SIZE=50
PGBOUNCER_MIN_POOL_SIZE=5
PGBOUNCER_RESERVE_POOL_SIZE=10
PGBOUNCER_MAX_CLIENT_CONN=2000

# Postgres tuning (passed as -c flags to the server)
POSTGRES_MAX_CONNECTIONS=300
POSTGRES_SHARED_BUFFERS=256MB

# Redis Sentinel master name (must match across the cluster)
REDIS_SENTINEL_MASTER_NAME=dbmaster

# Backup image override (empty = auto: stock postgres image when R2 is off,
# custom infra/backup image when R2 uploads are enabled)
INFRA_BACKUP_IMAGE=

# Docker image pins (defaults are the tested versions; override to pin/upgrade)
POSTGRES_CLIENT_IMAGE_TAG=17-alpine
PGBOUNCER_IMAGE_TAG=v1.25.1-p0
PGADMIN_IMAGE_TAG=latest
REDIS_IMAGE_TAG=7-alpine
HAPROXY_IMAGE_TAG=2.9-alpine
POSTGRES_EXPORTER_IMAGE_TAG=v0.17.1
REDIS_EXPORTER_IMAGE_TAG=v1.63.0
NODE_EXPORTER_IMAGE_TAG=v1.8.2
PROMETHEUS_IMAGE_TAG=v2.53.3
ALERTMANAGER_IMAGE_TAG=v0.27.0
LOKI_IMAGE_TAG=3.0.0
ALLOY_IMAGE_TAG=v1.8.3
GRAFANA_IMAGE_TAG=11.2.0
