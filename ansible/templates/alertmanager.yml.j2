{% if env.ALERT_EMAIL_TO and env.SMTP_USER and env.SMTP_PASSWORD %}
global:
  resolve_timeout: 5m
  smtp_smarthost: "{{ env.SMTP_SMARTHOST }}"
  smtp_from: "{{ env.ALERT_FROM }}"
  smtp_auth_username: "{{ env.SMTP_USER }}"
  smtp_auth_password: "{{ env.SMTP_PASSWORD }}"

route:
  group_by: ["alertname", "severity"]
  group_wait: 10s
  group_interval: 10s
  repeat_interval: 1h
  receiver: email

receivers:
  - name: email
    email_configs:
      - to: "{{ env.ALERT_EMAIL_TO }}"
        send_resolved: true
{% else %}
global:
  resolve_timeout: 5m

route:
  group_by: ["alertname", "severity"]
  group_wait: 10s
  group_interval: 10s
  repeat_interval: 1h
  receiver: default

receivers:
  - name: default
{% endif %}
